#!/bin/sh
set -eu

# Clay-only SSH gate.
# Intended for an OpenSSH authorized_keys forced command.
# Never starts a shell and never evaluates SSH_ORIGINAL_COMMAND as shell syntax.

BASE="/vol1/Docker/tapo-nas-lab"

deny() {
  echo "DENY: $1" >&2
  exit 126
}

resolve_tapo_path() {
  input=$1
  case "$input" in
    "$BASE"/*) ;;
    *) deny "path outside Tapo workspace" ;;
  esac
  resolved=$(readlink -f -- "$input" 2>/dev/null || true)
  [ -n "$resolved" ] || deny "path cannot be resolved"
  case "$resolved" in
    "$BASE"/*) ;;
    *) deny "resolved path outside Tapo workspace" ;;
  esac
  printf '%s\n' "$resolved"
}

cmd=${SSH_ORIGINAL_COMMAND:-}
[ -n "$cmd" ] || deny "interactive shell disabled"

# Reject shell metacharacters, traversal, and control characters before parsing.
case "$cmd" in
  *[\'\"\`\$\;\|\&\<\>\(\)\{\}\[\]\!\~\*\?\\]*|*..*|*[[:cntrl:]]*)
    deny "invalid command syntax"
    ;;
esac

set -- $cmd
verb=${1:-}
arg=${2:-}
extra=${3:-}
[ -z "$extra" ] || deny "too many arguments"

case "$verb" in
  uptime)
    [ -z "$arg" ] || deny "uptime takes no arguments"
    exec /usr/bin/uptime
    ;;
  free)
    [ -z "$arg" ] || deny "free takes no arguments"
    exec /usr/bin/free -h
    ;;
  df)
    [ -z "$arg" ] || deny "df takes no arguments"
    exec /bin/df -h /vol1
    ;;
  status)
    [ -z "$arg" ] || deny "status takes no arguments"
    printf '%s\n' "AI Guard Clay SSH gate: OK"
    printf 'workspace=%s\n' "$BASE"
    exec /usr/bin/date -Is
    ;;
  read)
    [ -n "$arg" ] || deny "read requires an absolute path"
    resolved=$(resolve_tapo_path "$arg")
    [ -f "$resolved" ] || deny "not a regular file"
    exec /usr/bin/sed -n '1,240p' -- "$resolved"
    ;;
  stat)
    [ -n "$arg" ] || deny "stat requires an absolute path"
    resolved=$(resolve_tapo_path "$arg")
    exec /usr/bin/stat -- "$resolved"
    ;;
  list)
    [ -z "$arg" ] || deny "list takes no arguments"
    exec /usr/bin/find "$BASE" -maxdepth 2 -type f -print
    ;;
  systemctl-status)
    [ -n "$arg" ] || deny "systemctl-status requires a unit"
    case "$arg" in
      [A-Za-z0-9_.@-]*) ;;
      *) deny "invalid systemd unit" ;;
    esac
    exec /usr/bin/systemctl status --no-pager --full "$arg"
    ;;
  *)
    deny "operation not allowlisted"
    ;;
esac
